function $330dda8029701c73$export$2e2bcd8739ae039(array) {
    const item = array.map(({ name: name, image: image, bloom_time: bloom_time, fact: fact })=>{
        return `
      <li class="card">
        <img class="card-image" src="${image}" alt="${name}">
        <h2 class="card-title">${name}</h2>
        <p class="card-info">
          <strong>\u{426}\u{432}\u{456}\u{442}\u{435}:</strong> ${bloom_time}
        </p>
        <p class="card-fact">${fact}</p>
      </li>
    `;
    }).join("");
    return item;
}


